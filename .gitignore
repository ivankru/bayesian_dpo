# Do not ignore directories (so .py files in subfolders are visible)
!*/

# Ignore everything else
*

# Exception: track .py files
!*.py

# Local CLI capability retention not in repo (logic in utils/metrics/capability_retention_eval.py)
/eval_capability_retention.py

# Exception: config folder (base_config and other .py)
!config/
!config/*.py

# Exception: utils folder (contains .py)
!utils/
!utils/*.py
!utils/metrics/
!utils/metrics/*.py
!utils/datasets/
!utils/datasets/*.py
!utils/losses/
!utils/losses/*.py
!utils/seed.py

# Exception: this .gitignore must be tracked
!.gitignore

# Jupyter checkpoints folder
.ipynb_checkpoints/

# Folders with results and data
alpaca2/
ifeval2/
checkpoints/

# Do not commit local scripts and tests (at end of file: overrides !*.py for these trees)
/scripts/
/scripts/**
/tests/
/tests/**
/test/
/test/**
